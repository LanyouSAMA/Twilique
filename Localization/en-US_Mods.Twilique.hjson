		DisplayName: Sapphire Sword
		Tooltip: Fires sapphire shards when hitting enemies.
	}

	TopazSword: {
		DisplayName: Topaz Sword
		Tooltip: Fires topaz shards when hitting enemies.
	}

	EmeraldSword: {
		DisplayName: Emerald Sword
		Tooltip:
			'''
			Has a 50% chance to fire emerald shards when attacking.
			Has a 100% chance to fire emerald shards when hitting enemies.
			'''
	}

	AmberSword: {
		DisplayName: Amber Sword
		Tooltip:
			'''
			Has a 75% chance to fire amber shards when attacking.
			Has a 100% chance to fire amber shards when hitting enemies.
			'''
	}

	RubySword: {
		DisplayName: Ruby Sword
		Tooltip:
			'''
			Has a 75% chance to fire ruby shards when attacking.
			Has a 100% chance to fire ruby shards when hitting enemies.
			'''
	}

	DiamondSword: {
		DisplayName: Diamond Sword
		Tooltip:
			'''
			Fires diamond shards when attacking.
			Fires an additional diamond shard when hitting enemies.
			'''
	}

	RainbowSword: {
		DisplayName: Rainbow Sword
		Tooltip:
			'''
			Fires seven-colored gemstone shards when attacking.
			"Do rainbows always have to be beautiful?"
			'''
	}

	SlimeRushBoots: {
		DisplayName: Slime Rush Shoes
		Tooltip:
			'''
			Double click the directional keys to sprint.
			There will be a 2-second cooldown after each sprint.
			'''
	}

	ManaStarDust: {
		DisplayName: Magic Stardust
		Tooltip:
			'''
			Sprinkle magic stardust
			After hitting an enemy monster, recover 3 mana
			"The beginning of everything."
			'''
